# ProxMobile Docker Environment Configuration

# Host port mapping (default: 3000 -> http://localhost:3000)
PORT=3000

# Node.js environment
NODE_ENV=production

# Optional default Proxmox host to pre-fill in login form (e.g. https://192.168.1.100:8006)
PROXMOX_DEFAULT_HOST=

# Optional default Proxmox authentication realm (pam, pve, ldap, openid)
PROXMOX_DEFAULT_REALM=pam
